{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "public": true,
  "alias": [
    { "domain": "nautisense.vercel.app", "deployment": "production" },
    { "domain": "preview.nautisense.vercel.app", "deployment": "preview" }
  ]
}
